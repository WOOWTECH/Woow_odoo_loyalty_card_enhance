<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hub Card: Gift Card -->
    <template id="mc_hub_gift_card"
              inherit_id="woow_member_center.portal_member_center_hub">
        <xpath expr="//div[@id='mc_hub_grid']" position="inside">
            <t t-if="show_gift_card">
                <a href="/my/member-center/gift-cards" class="mc-hub-card" data-mc-order="30">
                    <div class="mc-hub-card-icon">
                        <img src="/woow_mc_gift_card/static/src/img/gift-card.svg" alt="Gift Card"/>
                    </div>
                    <div class="mc-hub-card-body">
                        <div class="mc-hub-card-title">Gift Card</div>
                        <div class="mc-hub-card-text">View Gift Card Balance</div>
                    </div>
                    <div class="mc-hub-card-metric">
                        <span class="badge rounded-pill bg-info">
                            <t t-out="'{:,.0f}'.format(gift_balance)"/>
                            <t t-out="gift_point_name"/>
                        </span>
                    </div>
                </a>
            </t>
        </xpath>
    </template>

    <!-- Breadcrumbs -->
    <template id="portal_breadcrumb_gift_card"
              inherit_id="portal.portal_breadcrumbs"
              priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('mc_gift_cards', 'mc_gift_card_detail')"
                class="breadcrumb-item">
                <a href="/my/member-center">Member Center</a>
            </li>
            <li t-if="page_name == 'mc_gift_cards'"
                class="breadcrumb-item active">Gift Card</li>
            <li t-if="page_name == 'mc_gift_card_detail'" class="breadcrumb-item">
                <a href="/my/member-center/gift-cards">Gift Card</a>
            </li>
            <li t-if="page_name == 'mc_gift_card_detail'"
                class="breadcrumb-item active">
                <t t-out="card.program_id.name"/>
            </li>
        </xpath>
    </template>

    <!-- Gift Card List -->
    <template id="portal_mc_gift_card_list" name="Portal: Gift Card List">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Gift Card</t>
            </t>

            <t t-if="not cards">
                <div class="alert alert-info mt-3" role="alert">
                    No gift cards found.
                </div>
            </t>

            <t t-if="cards">
                <div class="table-responsive mt-3">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Program</th>
                                <th>Card No.</th>
                                <th class="text-end">Balance</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cards" t-as="card">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/member-center/gift-cards/#{card.id}">
                                            <t t-out="card.program_id.name"/>
                                        </a>
                                    </td>
                                    <td><code><t t-out="card.code"/></code></td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-out="'{:,.0f}'.format(card.points)"/>
                                            <t t-out="card.point_name"/>
                                        </strong>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="card.expiration_date and card.expiration_date &lt; datetime.date.today()">
                                            <span class="badge bg-secondary">Expired</span>
                                        </t>
                                        <t t-elif="card.points &lt;= 0">
                                            <span class="badge bg-warning text-dark">Zero Balance</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-success">Active</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- Gift Card Detail -->
    <template id="portal_mc_gift_card_detail" name="Portal: Gift Card Detail">
        <t t-call="portal.portal_layout">
            <div class="card mt-3">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-6">
                            <h3 class="mb-0">
                                <t t-out="card.program_id.name"/>
                            </h3>
                        </div>
                        <div class="col-12 col-md-6 text-md-end">
                            <span class="badge bg-info fs-5">
                                <t t-out="'{:,.0f}'.format(card.points)"/>
                                <t t-out="card.point_name"/>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Barcode Section -->
                    <div class="mc-barcode-section text-center mb-3">
                        <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=350&amp;height=60' % card.code"
                             class="mc-barcode-img" alt="barcode"/>
                        <div class="mc-barcode-code mt-1">
                            <code><t t-out="card.code"/></code>
                        </div>
                    </div>
                    <hr/>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <strong>Card No.:</strong>
                            <t t-out="card.code"/>
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Created:</strong>
                            <t t-out="card.create_date" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2" t-if="card.expiration_date">
                            <strong>Expires:</strong>
                            <t t-out="card.expiration_date" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-if="card.program_id.date_from or card.program_id.date_to">
                        <div class="row">
                            <div class="col-md-6 mb-2" t-if="card.program_id.date_from">
                                <strong>Program Start:</strong>
                                <t t-out="card.program_id.date_from"/>
                            </div>
                            <div class="col-md-6 mb-2" t-if="card.program_id.date_to">
                                <strong>Program End:</strong>
                                <t t-out="card.program_id.date_to"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Transaction History -->
            <t t-call="woow_member_center.portal_loyalty_history_table"/>

            <!-- Chatter -->
            <hr/>
            <div id="gift_card_communication" class="mt-4">
                <h3>Communication</h3>
                <t t-call="portal.message_thread"/>
            </div>
        </t>
    </template>

</odoo>
