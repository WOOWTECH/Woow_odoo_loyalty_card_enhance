<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Manual ledger adapters are deliberately separate from generic Sales
         and POS groups.  Membership implies ordinary Sales-manager visibility,
         but no other group gains the command authority granted below. -->
    <record id="group_consign_manager" model="res.groups">
        <field name="name">Consign Manager</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="loyalty_consign_grant_rule_company_rule" model="ir.rule">
        <field name="name">Consign grant rules: allowed companies</field>
        <field name="model_id" ref="model_loyalty_consign_grant_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="loyalty_consign_grant_line_company_rule" model="ir.rule">
        <field name="name">Consign grant lines: allowed companies</field>
        <field name="model_id" ref="model_loyalty_consign_grant_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="loyalty_consign_line_company_rule" model="ir.rule">
        <field name="name">Consign lines: allowed companies</field>
        <field name="model_id" ref="model_loyalty_consign_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="loyalty_consign_redemption_company_rule" model="ir.rule">
        <field name="name">Consign redemption documents: allowed companies</field>
        <field name="model_id" ref="model_loyalty_consign_redemption"/>
