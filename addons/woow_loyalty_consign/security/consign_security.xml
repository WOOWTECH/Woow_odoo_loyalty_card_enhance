    </record>

    <record id="loyalty_consign_redemption_line_company_rule" model="ir.rule">
        <field name="name">Consign redemption lines: allowed companies</field>
        <field name="model_id" ref="model_loyalty_consign_redemption_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="loyalty_consign_operation_company_rule" model="ir.rule">
        <field name="name">Consign operations: allowed companies</field>
        <field name="model_id" ref="model_loyalty_consign_operation"/>
