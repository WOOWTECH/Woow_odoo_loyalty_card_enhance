<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. 從「禮品卡與電子錢包」表單移除 consign（不再共用） -->
    <!-- 保留原生 gift_card + ewallet，consign 用獨立表單 -->

    <!-- 1.5 把 consign 從「折扣與優惠方案」列表排除 -->
    <record id="loyalty.loyalty_program_discount_loyalty_action" model="ir.actions.act_window">
        <field name="domain">[('program_type', 'not in', ('gift_card', 'ewallet', 'consign'))]</field>
    </record>

    <!-- 2. 把 consign 加入「折扣與會員計劃」表單的黑名單 -->
    <record id="loyalty_program_view_form_consign" model="ir.ui.view">
        <field name="name">loyalty.program.form.consign.blacklist</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <field name="program_type" position="attributes">
                <attribute name="options">{'blacklisted_values': ['gift_card', 'ewallet', 'consign']}</attribute>
            </field>
            <page name="rules_rewards" position="attributes">
                <attribute name="invisible">program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </page>
            <page name="communications" position="attributes">
                <attribute name="invisible">applies_on == 'current' or program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </page>
        </field>
    </record>

    <!-- 3. 寄品方案表單（繼承原生 loyalty 表單，與電子錢包欄位對齊） -->
    <record id="loyalty_program_consign_view_form" model="ir.ui.view">
        <field name="name">loyalty.program.consign.form</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- 表單標題 -->
            <form position="attributes">
                <attribute name="string">寄品方案</attribute>
            </form>

            <!-- 僅允許選擇 consign 類型 -->
            <field name="program_type" position="attributes">
                <attribute name="options">{'whitelisted_values': ['consign']}</attribute>
            </field>

            <!-- 隱藏原生統計按鈕，改用寄品卡專用按鈕 -->
            <button name="action_open_loyalty_cards" position="attributes">
                <attribute name="invisible">program_type == 'consign'</attribute>
            </button>
            <button name="action_open_loyalty_cards" position="after">
                <button name="action_view_consign_cards"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-id-card-o"
                        invisible="program_type != 'consign'">
                    <field name="consign_card_count" widget="statinfo" string="寄品卡"/>
                </button>
            </button>

            <!-- 新增寄品卡說明文字 -->
            <xpath expr="//field[@name='program_type']/parent::div/p[last()]" position="after">
                <p class="text-muted" invisible="program_type != 'consign'" colspan="2">
                    每個觸發產品使用一條授權規則；購買數量會倍增規則內的所有授權品項。
                </p>
            </xpath>

            <!-- Explicit consign trigger headers and entitlement children. -->
            <field name="mail_template_id" position="before">
                <group string="寄品授權規則" invisible="program_type != 'consign'" colspan="2">
                    <field name="consign_trigger_product_ids"
                           string="觸發產品摘要"
                           widget="many2many_tags"
                           readonly="1"/>
                    <field name="consign_grant_rule_ids"
                           string="授權規則"
                           nolabel="1"
                           colspan="2">
                        <list string="授權規則">
                            <field name="trigger_product_id"/>
                            <field name="company_id" optional="hide"/>
                        </list>
                        <form string="寄品授權規則">
                            <group>
                                <field name="trigger_product_id"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                            <field name="grant_line_ids" nolabel="1">
                                <list editable="bottom" string="授權品項">
                                    <field name="entitlement_product_id"/>
                                    <field name="entitlement_uom_category_id" column_invisible="True"/>
                                    <field name="product_uom_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </form>
                    </field>
                </group>
            </field>

            <!-- 顯示通知模板（加入 consign） -->
            <field name="mail_template_id" position="attributes">
                <attribute name="invisible">program_type not in ('gift_card', 'ewallet', 'consign')</attribute>
            </field>

            <!-- 隱藏貨幣欄位 -->
            <field name="currency_id" position="attributes">
                <attribute name="invisible">program_type == 'consign'</attribute>
            </field>

            <!-- 隱藏價格表 -->
            <field name="pricelist_ids" position="attributes">
                <attribute name="invisible">program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </field>

            <!-- 隱藏日期區間 -->
            <field name="date_from" position="attributes">
                <attribute name="invisible">program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </field>
            <field name="date_to" position="attributes">
                <attribute name="invisible">program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </field>

            <!-- 隱藏使用次數限制 -->
            <xpath expr="//label[@for='limit_usage']" position="attributes">
                <attribute name="invisible">program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </xpath>
            <xpath expr="//span[field[@name='limit_usage']]" position="attributes">
                <attribute name="invisible">program_type in ('gift_card', 'ewallet', 'consign')</attribute>
            </xpath>
        </field>
    </record>

    <!-- 4. 寄品方案動作 -->
    <record id="loyalty_program_consign_action" model="ir.actions.act_window">
        <field name="name">寄品方案</field>
        <field name="res_model">loyalty.program</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('program_type', '=', 'consign')]</field>
        <field name="context">{'default_program_type': 'consign'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一個寄品方案
            </p>
            <p>
                寄品卡讓客戶購買後寄存商品或服務，日後分次取用。
            </p>
        </field>
    </record>

    <!-- 5. 寄品方案列表 view -->
    <record id="loyalty_program_consign_view_list" model="ir.ui.view">
        <field name="name">loyalty.program.consign.list</field>
        <field name="model">loyalty.program</field>
        <field name="arch" type="xml">
            <list string="寄品方案">
                <field name="name" string="計劃名稱"/>
                <field name="program_type" string="計劃類型"/>
                <field name="consign_trigger_product_ids" string="觸發產品" widget="many2many_tags"/>
                <field name="consign_card_count" string="寄品卡數"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- 6. 動作綁定 list + form view -->
    <record id="action_loyalty_program_list_consign" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="sequence">1</field>
        <field name="view_id" ref="loyalty_program_consign_view_list"/>
        <field name="act_window_id" ref="loyalty_program_consign_action"/>
    </record>
    <record id="action_loyalty_program_form_consign" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="sequence">2</field>
        <field name="view_id" ref="loyalty_program_consign_view_form"/>
        <field name="act_window_id" ref="loyalty_program_consign_action"/>
    </record>

</odoo>
