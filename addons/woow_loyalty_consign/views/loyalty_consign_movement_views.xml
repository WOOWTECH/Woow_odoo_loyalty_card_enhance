<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_consign_movement_view_list" model="ir.ui.view">
        <field name="name">loyalty.consign.movement.list</field>
        <field name="model">loyalty.consign.movement</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="occurred_at"/>
                <field name="movement_type"/>
                <field name="card_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_uom_id"/>
                <field name="quantity"/>
                <field name="unit_value" optional="hide"/>
                <field name="value_delta" optional="hide"/>
                <field name="source_channel"/>
                <field name="source_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="loyalty_consign_movement_view_form" model="ir.ui.view">
        <field name="name">loyalty.consign.movement.form</field>
        <field name="model">loyalty.consign.movement</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_source" type="object" string="Open Source"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="occurred_at"/>
                            <field name="movement_type"/>
                            <field name="operation_id"/>
                            <field name="idempotency_key"/>
                            <field name="original_movement_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="card_id"/>
                            <field name="aggregate_line_id"/>
                        </group>
                    </group>
                    <group string="Immutable Product Snapshot">
                        <group>
                            <field name="product_id"/>
                            <field name="product_uom_id"/>
                            <field name="product_desc_snapshot"/>
                            <field name="lot_snapshot"/>
                            <field name="storage_snapshot"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="currency_id"/>
                            <field name="unit_value"/>
                            <field name="value_delta"/>
                        </group>
                    </group>
                    <group string="Source Snapshot">
                        <field name="source_channel"/>
                        <field name="source_model"/>
                        <field name="source_res_id"/>
                        <field name="source_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="loyalty_consign_movement_action" model="ir.actions.act_window">
        <field name="name">Consignment Movements</field>
        <field name="res_model">loyalty.consign.movement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
</odoo>
