<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hub Card: E-Wallet -->
    <template id="mc_hub_ewallet_card"
              inherit_id="woow_member_center.portal_member_center_hub">
        <xpath expr="//div[@id='mc_hub_grid']" position="inside">
            <t t-if="show_ewallet">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/woow_mc_ewallet/static/src/img/ewallet.svg'"/>
                    <t t-set="title">E-Wallet</t>
                    <t t-set="url" t-value="'/my/member-center/ewallet'"/>
                    <t t-set="text">View Balance &amp; Transactions</t>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Breadcrumbs -->
    <template id="portal_breadcrumb_ewallet"
              inherit_id="portal.portal_breadcrumbs"
              priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('mc_ewallet', 'mc_ewallet_detail')" class="breadcrumb-item">
                <a href="/my/member-center">Member Center</a>
            </li>
            <li t-if="page_name == 'mc_ewallet'"
                class="breadcrumb-item active">E-Wallet</li>
            <li t-if="page_name == 'mc_ewallet_detail'" class="breadcrumb-item">
                <a href="/my/member-center/ewallet">E-Wallet</a>
            </li>
            <li t-if="page_name == 'mc_ewallet_detail'"
                class="breadcrumb-item active">
                <t t-out="card.program_id.name"/>
            </li>
        </xpath>
    </template>

    <!-- E-Wallet List -->
    <template id="portal_mc_ewallet" name="Portal: E-Wallet List">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">E-Wallet</t>
            </t>

            <t t-if="not cards">
                <div class="alert alert-info mt-3" role="alert">
                    No e-wallets found.
                </div>
            </t>

            <t t-if="cards">
                <!-- Total Balance -->
                <div class="mc-balance-hero mt-4">
                    <div class="mc-balance-hero-label">Total Balance</div>
                    <div class="mc-balance-hero-amount">
                        <t t-out="'{:,.0f}'.format(total_balance)"/>
                        <span class="mc-balance-hero-unit">
                            <t t-out="point_name"/>
                        </span>
                    </div>
                </div>

                <!-- Wallet Details -->
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Program</th>
                            <th>Card No.</th>
                            <th class="text-end">Balance</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <t t-foreach="cards" t-as="card">
                        <tr>
                            <td>
                                <a t-attf-href="/my/member-center/ewallet/#{card.id}">
                                    <t t-out="card.program_id.name"/>
                                </a>
                            </td>
                            <td><code><t t-out="card.code"/></code></td>
                            <td class="text-end">
                                <strong>
                                    <t t-out="'{:,.0f}'.format(card.points)"/>
                                    <t t-out="card.point_name"/>
                                </strong>
                            </td>
                            <td class="text-center">
                                <t t-if="card.expiration_date and card.expiration_date &lt; datetime.date.today()">
                                    <span class="badge rounded-pill text-bg-secondary">Expired</span>
                                </t>
                                <t t-elif="card.points &lt;= 0">
                                    <span class="badge rounded-pill text-bg-warning">Zero Balance</span>
                                </t>
                                <t t-else="">
                                    <span class="badge rounded-pill text-bg-success">Active</span>
                                </t>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- E-Wallet Detail -->
    <template id="portal_mc_ewallet_detail" name="Portal: E-Wallet Detail"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">

            <div class="row o_portal_ewallet_sidebar">
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <div class="d-flex align-items-center flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#card_header">Details</a>
                                    </li>
                                    <li class="nav-item" t-if="history_lines">
                                        <a class="nav-link p-0" href="#transaction_history">Transaction History</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#discussion">Communication</a>
                                    </li>
                                </ul>
                            </div>

                            <div class="d-flex flex-column gap-2">
                                <h6><small class="text-muted">Balance</small></h6>
                                <span class="badge rounded-pill text-bg-primary">
                                    <t t-out="'{:,.0f}'.format(card.points)"/>
                                    <t t-out="card.point_name"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </t>

                <div id="ewallet_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header" data-anchor="true">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        <t t-out="card.program_id.name"/>
                                    </h3>
                                </div>
                                <div class="col-auto">
                                    <span class="badge rounded-pill text-bg-primary">
                                        <t t-out="'{:,.0f}'.format(card.points)"/>
                                        <t t-out="card.point_name"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div id="card_body">
                            <!-- Barcode Section -->
                            <div class="mc-barcode-section text-center mb-3">
                                <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=350&amp;height=60' % card.code"
                                     class="mc-barcode-img" alt="barcode"/>
                                <div class="mc-barcode-code mt-1">
                                    <code><t t-out="card.code"/></code>
                                </div>
                            </div>
                            <hr/>
                            <div class="row mb-4">
                                <div class="col-12 col-md-6">
                                    <div><strong>Card No.:</strong>
                                        <t t-out="card.code"/>
                                    </div>
                                    <div><strong>Created:</strong>
                                        <t t-out="card.create_date" t-options="{'widget': 'date'}"/>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div t-if="card.expiration_date">
                                        <strong>Expires:</strong>
                                        <t t-out="card.expiration_date" t-options="{'widget': 'date'}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transaction History -->
                    <div id="transaction_history" data-anchor="true">
                        <t t-call="woow_member_center.portal_loyalty_history_table"/>
                    </div>

                    <hr/>
                    <div id="discussion" data-anchor="true">
                        <h3>Communication</h3>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
