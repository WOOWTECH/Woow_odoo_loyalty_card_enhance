<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hub Card: Coupon -->
    <template id="mc_hub_coupon_card"
              inherit_id="woow_member_center.portal_member_center_hub">
        <xpath expr="//div[@id='mc_hub_grid']" position="inside">
            <t t-if="show_coupon">
                <a href="/my/member-center/coupons" class="mc-hub-card" data-mc-order="40">
                    <div class="mc-hub-card-icon">
                        <img src="/woow_mc_coupon/static/src/img/coupon.svg" alt="Coupon"/>
                    </div>
                    <div class="mc-hub-card-body">
                        <div class="mc-hub-card-title">Coupon</div>
                        <div class="mc-hub-card-text">View Available Coupons</div>
                    </div>
                    <div class="mc-hub-card-metric">
                        <span class="badge rounded-pill bg-warning text-dark">
                            <t t-out="coupon_count"/>
                        </span>
                    </div>
                </a>
            </t>
        </xpath>
    </template>

    <!-- Breadcrumbs -->
    <template id="portal_breadcrumb_coupon"
              inherit_id="portal.portal_breadcrumbs"
              priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('mc_coupons', 'mc_coupon_detail')"
                class="breadcrumb-item">
                <a href="/my/member-center">Member Center</a>
            </li>
            <li t-if="page_name == 'mc_coupons'"
                class="breadcrumb-item active">Coupons</li>
            <li t-if="page_name == 'mc_coupon_detail'" class="breadcrumb-item">
                <a href="/my/member-center/coupons">Coupons</a>
            </li>
            <li t-if="page_name == 'mc_coupon_detail'"
                class="breadcrumb-item active">
                <t t-out="card.code"/>
            </li>
        </xpath>
    </template>

    <!-- Coupon List -->
    <template id="portal_mc_coupon_list" name="Portal: Coupon List">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Coupons</t>
            </t>

            <t t-if="not cards">
                <div class="alert alert-info mt-3" role="alert">
                    No coupons found.
                </div>
            </t>

            <t t-if="cards">
                <div class="table-responsive mt-3">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Program</th>
                                <th>Coupon Code</th>
                                <th>Description</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cards" t-as="card">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/member-center/coupons/#{card.id}">
                                            <t t-out="card.program_id.name"/>
                                        </a>
                                    </td>
                                    <td>
                                        <code><t t-out="card.code"/></code>
                                    </td>
                                    <td>
                                        <t t-if="card.program_id.reward_ids">
                                            <t t-out="card.program_id.reward_ids[:1].description"/>
                                        </t>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="card.points &lt;= 0">
                                            <span class="badge bg-secondary">Used</span>
                                        </t>
                                        <t t-elif="card.expiration_date and card.expiration_date &lt; datetime.date.today()">
                                            <span class="badge bg-danger">Expired</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge bg-success">Available</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- Coupon Detail -->
    <template id="portal_mc_coupon_detail" name="Portal: Coupon Detail">
        <t t-call="portal.portal_layout">
            <div class="card mt-3">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-6">
                            <h3 class="mb-0">
                                <t t-out="card.program_id.name"/>
                            </h3>
                        </div>
                        <div class="col-12 col-md-6 text-md-end">
                            <span class="badge bg-warning text-dark fs-5">
                                <t t-out="card.code"/>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Barcode Section -->
                    <div class="mc-barcode-section text-center mb-3">
                        <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=350&amp;height=60' % card.code"
                             class="mc-barcode-img" alt="barcode"/>
                        <div class="mc-barcode-code mt-1">
                            <code><t t-out="card.code"/></code>
                        </div>
                    </div>
                    <hr/>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <strong>Coupon Code:</strong>
                            <code class="fs-5"><t t-out="card.code"/></code>
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Created:</strong>
                            <t t-out="card.create_date" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2" t-if="card.expiration_date">
                            <strong>Expires:</strong>
                            <t t-out="card.expiration_date" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-if="card.program_id.date_from or card.program_id.date_to">
                        <div class="row">
                            <div class="col-md-6 mb-2" t-if="card.program_id.date_from">
                                <strong>Valid From:</strong>
                                <t t-out="card.program_id.date_from"/>
                            </div>
                            <div class="col-md-6 mb-2" t-if="card.program_id.date_to">
                                <strong>Valid Until:</strong>
                                <t t-out="card.program_id.date_to"/>
                            </div>
                        </div>
                    </t>

                    <!-- Reward Details -->
                    <t t-if="card.program_id.reward_ids">
                        <h5 class="mt-3">Reward Details</h5>
                        <t t-foreach="card.program_id.reward_ids" t-as="reward">
                            <div class="card mb-2">
                                <div class="card-body py-2">
                                    <t t-out="reward.description"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>

            <!-- Transaction History -->
            <t t-call="woow_member_center.portal_loyalty_history_table"/>

            <!-- Chatter -->
            <hr/>
            <div id="coupon_communication" class="mt-4">
                <h3>Communication</h3>
                <t t-call="portal.message_thread"/>
            </div>
        </t>
    </template>

</odoo>
