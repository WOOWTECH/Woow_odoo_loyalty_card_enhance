<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Portal Home: Member Center Entry Card                        -->
    <!-- ============================================================ -->
    <template id="portal_my_home_member_center"
              name="Portal: Member Center Entry"
              inherit_id="portal.portal_my_home"
              priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/woow_member_center/static/src/img/member-center.svg'"/>
                <t t-set="title">Member Center</t>
                <t t-set="url" t-value="'/my/member-center'"/>
                <t t-set="text">My Member Services</t>
                <t t-set="placeholder_count" t-value="'member_center_count'"/>
            </t>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Hub Page: Member Center Home (empty grid, sub-modules inject) -->
    <!-- ============================================================ -->
    <template id="portal_member_center_hub" name="Portal: Member Center Hub">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Member Center</t>
            </t>

            <div class="mc-hub-grid mt-4" id="mc_hub_grid">
                <!-- Sub-modules inject their cards via xpath position="inside" -->
            </div>

            <!-- Empty state (when no sub-modules installed or no data) -->
            <div class="mc-hub-empty text-center text-muted py-5" id="mc_hub_empty">
                <img src="/woow_member_center/static/src/img/member-center.svg"
                     style="width:64px; opacity:.5;" class="mb-3" alt=""/>
                <p>No member services available.</p>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Breadcrumbs (Hub only - sub-modules add their own)           -->
    <!-- ============================================================ -->
    <template id="portal_breadcrumb_member_center"
              inherit_id="portal.portal_breadcrumbs"
              priority="25">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <!-- Hub -->
            <li t-if="page_name == 'member_center'"
                class="breadcrumb-item active">Member Center</li>

            <!-- Transaction History Page -->
            <li t-if="page_name == 'mc_card_history'" class="breadcrumb-item">
                <a href="/my/member-center">Member Center</a>
            </li>
            <li t-if="page_name == 'mc_card_history'" class="breadcrumb-item">
                <a t-att-href="parent_url"><t t-out="parent_title"/></a>
            </li>
            <li t-if="page_name == 'mc_card_history'" class="breadcrumb-item">
                <a t-att-href="card_url"><t t-out="card.program_id.name"/></a>
            </li>
            <li t-if="page_name == 'mc_card_history'" class="breadcrumb-item active">
                Transaction History
            </li>
        </xpath>
    </template>

</odoo>
