<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Shared Transaction History Table Snippet (embedded in detail) -->
    <!-- ============================================================ -->
    <template id="portal_loyalty_history_table" name="Portal: Transaction History Snippet">
        <t t-if="history_lines">
            <div class="card mt-3 mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Transaction History</h5>
                    <span class="badge bg-secondary rounded-pill">
                        <t t-out="history_count"/>
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Related Order</th>
                                    <th class="text-end">Previous Balance</th>
                                    <th class="text-end">Earned</th>
                                    <th class="text-end">Used</th>
                                    <th class="text-end">New Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="history_lines" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-out="line.create_date" t-options="{'widget': 'date'}"/>
                                        </td>
                                        <td>
                                            <t t-out="line.description or ''"/>
                                        </td>
                                        <td>
                                            <t t-if="line.order_id">
                                                <t t-set="order_portal_url" t-value="line._get_order_portal_url()"/>
                                                <t t-set="order_description" t-value="line._get_order_description()"/>
                                                <a t-if="order_portal_url"
                                                   t-att-href="order_portal_url">
                                                    <t t-out="order_description"/>
                                                </a>
                                                <span t-else="" t-out="order_description"/>
                                            </t>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                        <td class="text-end text-muted">
                                            <t t-out="line.card_id._format_points(line.balance_before)"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="line.issued"
                                                  class="text-success fw-bold">
                                                +<t t-out="line.card_id._format_points(line.issued)"/>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span t-if="line.used"
                                                  class="text-danger fw-bold">
                                                -<t t-out="line.card_id._format_points(line.used)"/>
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold">
                                            <t t-out="line.card_id._format_points(line.balance_after)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Show "View All" when more than 10 records -->
                <div class="card-footer text-center" t-if="show_history_link">
                    <a t-att-href="history_url">
                        View All History (<t t-out="history_count"/> records)
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
