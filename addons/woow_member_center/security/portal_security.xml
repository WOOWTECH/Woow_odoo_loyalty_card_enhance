<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal: 只能看到自己的 loyalty card -->
    <record id="loyalty_card_portal_rule" model="ir.rule">
        <field name="name">Portal: own loyalty cards</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id), ('company_id', 'in', [False, user.company_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- The portal read ACL for history needs an owner rule as well. -->
    <record id="loyalty_history_portal_rule" model="ir.rule">
        <field name="name">Portal: own loyalty history</field>
        <field name="model_id" ref="loyalty.model_loyalty_history"/>
        <field name="domain_force">[('card_id.partner_id', '=', user.partner_id.id), ('company_id', 'in', [False, user.company_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
