<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="woow_loyalty_consign_pos.ConsignSearchPopup">
        <Dialog title="title" size="'lg'">
            <div class="consign-search-popup">
                <!-- Tab buttons -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button t-attf-class="nav-link #{state.mode === 'code' ? 'active' : ''}"
                                t-on-click="() => this.switchMode('code')">
                            <i class="fa fa-barcode me-1"/>Card Code
                        </button>
                    </li>
                    <li class="nav-item">
                        <button t-attf-class="nav-link #{state.mode === 'customer' ? 'active' : ''}"
                                t-on-click="() => this.switchMode('customer')">
                            <i class="fa fa-search me-1"/>Search Customer
                        </button>
                    </li>
                </ul>

                <!-- Code input tab -->
                <div t-if="state.mode === 'code'" class="mb-3">
                    <div class="input-group input-group-lg">
                        <input type="text"
                               class="form-control"
                               placeholder="Enter card code..."
                               t-model="state.codeInput"
                               t-on-keydown="onCodeKeydown"
                               t-ref="codeInput"/>
                        <button class="btn btn-primary"
                                t-att-disabled="state.loading || !state.codeInput.trim()"
                                t-on-click="searchByCode">
                            <i t-attf-class="fa #{state.loading ? 'fa-spinner fa-spin' : 'fa-arrow-right'}"/>
                        </button>
                    </div>
                </div>

                <!-- Customer search tab -->
                <div t-if="state.mode === 'customer'" class="mb-3">
                    <div class="input-group input-group-lg mb-3">
                        <input type="text"
                               class="form-control"
                               placeholder="Customer name or card code..."
                               t-model="state.customerQuery"
                               t-on-keydown="onCustomerKeydown"
                               t-ref="customerInput"/>
                        <button class="btn btn-primary"
                                t-att-disabled="state.loading || !state.customerQuery.trim()"
                                t-on-click="searchByCustomer">
                            <i t-attf-class="fa #{state.loading ? 'fa-spinner fa-spin' : 'fa-search'}"/>
                        </button>
                    </div>

                    <!-- Results table -->
                    <t t-if="state.cards.length > 0">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Program</th>
                                    <th>Card Code</th>
                                    <th class="text-center">Items</th>
                                    <th class="text-center">Remaining Qty</th>
                                    <th/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.cards" t-as="card" t-key="card.card_id">
                                    <tr class="cursor-pointer" t-on-click="() => this.selectCard(card)">
                                        <td>
                                            <strong t-esc="card.partner_name"/>
                                        </td>
                                        <td t-esc="card.program_name"/>
                                        <td>
                                            <code t-esc="card.card_code"/>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary" t-esc="card.active_items"/>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-info" t-esc="card.total_remaining_qty"/>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-arrow-right"/>
                                            </button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>

                <!-- Error message -->
                <div t-if="state.error" class="alert alert-warning mt-2">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.error"/>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">
                    Close
                </button>
            </t>
        </Dialog>
    </t>
</templates>
