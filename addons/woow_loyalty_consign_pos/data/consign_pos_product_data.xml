<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Service product used as POS order line for consignment redemptions ($0) -->
    <record id="consign_pos_redemption_product" model="product.product">
        <field name="name">Consignment Redemption</field>
        <field name="type">service</field>
        <field name="list_price">0</field>
        <field name="available_in_pos">True</field>
        <field name="sale_ok">False</field>
        <field name="purchase_ok">False</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
